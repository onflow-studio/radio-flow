{
  "name": "radio-flow",
  "productName": "Radio Flow",
  "version": "0.1.3",
  "private": true,
  "description": "A focus radio that lives in your macOS menu bar",
  "main": "main/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --mac dir",
    "install-app": "pnpm dist && rm -rf \"/Applications/Radio Flow.app\" && cp -R \"release/mac-arm64/Radio Flow.app\" /Applications/",
    "release": "vite build && electron-builder --mac zip"
  },
  "build": {
    "appId": "dev.f3r.flow-radio",
    "productName": "Radio Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**",
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/icon.icns"
    }
  },
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "license": "MIT",
  "author": "Fer Martin",
  "repository": {
    "type": "git",
    "url": "https://github.com/onflow-studio/radio-flow"
  }
}
